{
  "name": "nocturne-consolidator",
  "version": "1.0.0",
  "description": "Simple utility to consolidate all your NIGHT into fewer addresses.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "nocturne-consolidator": "./bin/nocturne-consolidator.js"
  },
  "scripts": {
    "start-prod": "tsx src/index.ts --input-file input.json",
    "start-dev": "tsx src/index.ts --input-file input.sample.json --skip-statistics-dl",
    "clean": "rimraf dist ./stats-output",
    "tsc:check": "tsc --noEmit",
    "build": "npm run clean && tsc",
    "prepare": "npm run build",
    "lint": "npx eslint src test",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggcaponetto/nocturne-consolidator.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ggcaponetto/nocturne-consolidator/issues"
  },
  "homepage": "https://github.com/ggcaponetto/nocturne-consolidator#readme",
  "dependencies": {
    "@meshsdk/core": "^1.9.0-beta.87",
    "@meshsdk/react": "^1.9.0-beta.87",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "pino": "^10.1.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/yargs": "^17.0.34",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.8"
  }
}
